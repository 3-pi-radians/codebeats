# secrets
.env
*.json.key
gcp-*.json

# data: raw responses contain usernames and comment text; never commit
data/*
!data/.gitkeep
# the pilot repo list is metadata only, but stays out of git with the rest of data/

# logs: the BigQuery byte log is committed, job logs are not
logs/*
!logs/bigquery_bytes.csv

# python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# markdown: only README.md is ever committed (user rule); docs/, reports/, CLAUDE.md stay local
*.md
!README.md
