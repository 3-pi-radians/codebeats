# Copy to .env and fill in. Never commit .env.
# GitHub fine-grained token(s), public read-only. Comma-separate several to share the rate limit.
GITHUB_TOKENS=
# Google Cloud project that BigQuery jobs are billed to (auth: gcloud auth application-default login)
GCP_PROJECT=
# Random salt for hashing usernames, e.g. output of: python3 -c "import secrets; print(secrets.token_hex(32))"
CODEBEAT_SALT=
